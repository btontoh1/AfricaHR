{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@africahr/platform-core": ["./libs/platform/core/src/index.ts"],
      "@africahr/platform-database": ["./libs/platform/database/src/index.ts"],
      "@africahr/platform-redis": ["./libs/platform/redis/src/index.ts"],
      "@africahr/platform-health": ["./libs/platform/health/src/index.ts"],
      "@africahr/tenancy-domain": ["./libs/tenancy/domain/src/index.ts"],
      "@africahr/tenancy-data-access": [
        "./libs/tenancy/data-access/src/index.ts"
      ],
      "@africahr/tenancy-feature": ["./libs/tenancy/feature/src/index.ts"],
      "@africahr/platform-auth": ["./libs/platform/auth/src/index.ts"],
      "@africahr/platform-audit": ["./libs/platform/audit/src/index.ts"],
      "@africahr/iam-domain": ["./libs/iam/domain/src/index.ts"],
      "@africahr/iam-data-access": ["./libs/iam/data-access/src/index.ts"],
      "@africahr/iam-feature": ["./libs/iam/feature/src/index.ts"],
      "@africahr/employee-domain": ["./libs/employee/domain/src/index.ts"],
      "@africahr/employee-data-access": [
        "./libs/employee/data-access/src/index.ts"
      ],
      "@africahr/employee-feature": ["./libs/employee/feature/src/index.ts"],
      "@africahr/payroll-domain": ["./libs/payroll/domain/src/index.ts"],
      "@africahr/payroll-data-access": [
        "./libs/payroll/data-access/src/index.ts"
      ],
      "@africahr/payroll-feature": ["./libs/payroll/feature/src/index.ts"],
      "@africahr/leave-domain": ["./libs/leave/domain/src/index.ts"],
      "@africahr/leave-data-access": ["./libs/leave/data-access/src/index.ts"],
      "@africahr/leave-feature": ["./libs/leave/feature/src/index.ts"],
      "@africahr/attendance-domain": ["./libs/attendance/domain/src/index.ts"],
      "@africahr/attendance-data-access": [
        "./libs/attendance/data-access/src/index.ts"
      ],
      "@africahr/attendance-feature": ["./libs/attendance/feature/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
