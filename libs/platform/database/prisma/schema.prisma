// AfricaHR — shared-schema, multi-tenant PostgreSQL database.
//
// Tenant isolation convention (see RLS_CONVENTION.md in this directory):
// every tenant-scoped model gets a `tenantId` column, an index on it, and a
// matching Postgres Row-Level Security policy applied via a raw-SQL migration.
// `Tenant` itself is the tenant registry (platform-root) and is exempt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy & Organization (Module 1)
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

/// The SaaS account. Platform-root table — no tenantId, no RLS.
model Tenant {
  id       String       @id @default(uuid())
  name     String
  slug     String       @unique
  status   TenantStatus @default(TRIAL)
  country  String
  currency String
  timezone String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  organizations Organization[]
  users         User[]

  @@map("tenants")
}

/// A legal entity under a tenant (a tenant may own more than one — e.g. a
/// holding company with subsidiaries — so this is tenantId-scoped rather
/// than folded into Tenant as a 1:1).
model Organization {
  id                      String  @id @default(uuid())
  tenantId                String  @map("tenant_id")
  legalName               String  @map("legal_name")
  tradingName             String? @map("trading_name")
  countryCode             String  @map("country_code")
  registrationNumber      String  @map("registration_number")
  taxIdentificationNumber String? @map("tax_identification_number")
  /// Country-specific registration fields that don't warrant a dedicated
  /// column yet (e.g. Ghana SSNIT employer number).
  metadata                Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  units     OrganizationUnit[]
  employees Employee[]
  payRuns   PayRun[]

  @@index([tenantId])
  @@map("organizations")
}

/// Department/branch within an Organization. Self-referencing hierarchy.
model OrganizationUnit {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  parentId       String? @map("parent_id")
  name           String
  code           String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  organization Organization       @relation(fields: [organizationId], references: [id])
  parent       OrganizationUnit?  @relation("OrganizationUnitToParent", fields: [parentId], references: [id])
  children     OrganizationUnit[] @relation("OrganizationUnitToParent")
  employees    Employee[]

  @@index([tenantId])
  @@index([organizationId])
  @@map("organization_units")
}

// ---------------------------------------------------------------------------
// IAM (Module 2)
// ---------------------------------------------------------------------------

/// Fixed, system-defined roles. Tenants assign users to these; they cannot
/// define their own roles (see project memory for why — a deliberate v1
/// scope cut, not an oversight).
enum SystemRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  HR_MANAGER
  PAYROLL_MANAGER
  EMPLOYEE
}

/// tenantId is nullable: null identifies a platform admin, who isn't scoped
/// to any tenant (tenants are ops-provisioned by platform admins, not
/// self-serve). email is globally unique (not per-tenant) so login can
/// resolve a user from email+password alone, without first knowing which
/// tenant to look in.
model User {
  id           String     @id @default(uuid())
  tenantId     String?    @map("tenant_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  role         SystemRole
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]
  employee      Employee?

  @@index([tenantId])
  @@map("users")
}

/// Opaque, hashed, stateful — unlike the (stateless, JWT) access token, so
/// logout/revocation is possible. Rotated on every refresh.
model RefreshToken {
  id        String    @id @default(uuid())
  tenantId  String?   @map("tenant_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// Generic audit trail, written via explicit AuditService.record() calls
/// from any module's services — deliberately not automatic/interceptor-based,
/// to keep exactly what gets logged predictable and easy to test.
model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  actorUserId  String?  @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Employee Management (Module 3)
// ---------------------------------------------------------------------------

enum EmploymentStatus {
  PENDING_ONBOARDING
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

/// The employee's HR record. userId is nullable and independent of
/// employmentStatus — HR can onboard someone into the system (or employ
/// someone who never needs portal access) without a User account existing
/// (see project memory for that decision). Compensation here is a current
/// summary only; actual payroll processing (pay runs, tax, payslips) is
/// Module 4's responsibility, which reads this rather than duplicating it.
model Employee {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  organizationId     String  @map("organization_id")
  organizationUnitId String? @map("organization_unit_id")
  userId             String? @unique @map("user_id")
  managerId          String? @map("manager_id")

  employeeNumber String @map("employee_number")

  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  dateOfBirth   DateTime? @map("date_of_birth")
  gender        String?
  nationality   String?
  phone         String?
  personalEmail String?   @map("personal_email")

  jobTitle         String           @map("job_title")
  employmentType   EmploymentType   @map("employment_type")
  employmentStatus EmploymentStatus @default(PENDING_ONBOARDING) @map("employment_status")
  hireDate         DateTime         @map("hire_date")
  terminationDate  DateTime?        @map("termination_date")

  baseSalary   Decimal? @map("base_salary")
  payFrequency String?  @map("pay_frequency")
  currency     String?

  countryCode String @map("country_code")
  /// Country-specific fields without a dedicated column (e.g. Ghana Card
  /// number), same pattern as Organization.metadata.
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  organization      Organization             @relation(fields: [organizationId], references: [id])
  organizationUnit  OrganizationUnit?        @relation(fields: [organizationUnitId], references: [id])
  user              User?                    @relation(fields: [userId], references: [id])
  manager           Employee?                @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports     Employee[]               @relation("EmployeeManager")
  historyEntries    EmploymentHistoryEntry[]
  payslips          Payslip[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  attendanceRecords AttendanceRecord[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([organizationId])
  @@index([organizationUnitId])
  @@index([managerId])
  @@map("employees")
}

/// Structured, queryable point-in-time history of employment changes (title,
/// department, salary, status) — chosen over relying on AuditLog's generic
/// JSON trail, since "what was X's title on date Y" is a standard HR
/// reporting need AuditLog isn't built to answer well.
model EmploymentHistoryEntry {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  employeeId    String   @map("employee_id")
  /// e.g. "TITLE_CHANGE", "DEPARTMENT_TRANSFER", "STATUS_CHANGE", "SALARY_CHANGE"
  changeType    String   @map("change_type")
  fieldName     String   @map("field_name")
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  effectiveDate DateTime @map("effective_date")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@map("employment_history_entries")
}

// ---------------------------------------------------------------------------
// Payroll Engine (Module 4)
// ---------------------------------------------------------------------------

/// GRA-published monthly PAYE tax bands. Platform-root reference data — no
/// tenantId, no RLS, same exemption as Tenant (see RLS_CONVENTION.md): a
/// tenant does not get to set its own income tax law. Effective-dated so a
/// historical payslip stays reproducible after a rate change. Seeded with
/// placeholder figures that must be confirmed against GRA's current
/// published table before any real payroll run (see seed.ts).
model StatutoryTaxBand {
  id            String    @id @default(uuid())
  countryCode   String    @map("country_code")
  /// Ascending band order within (countryCode, effectiveFrom); band 1 is the
  /// lowest chargeable-income band.
  order         Int
  lowerBound    Decimal   @map("lower_bound")
  /// null = no upper bound (the top band).
  upperBound    Decimal?  @map("upper_bound")
  rate          Decimal
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@index([countryCode, effectiveFrom])
  @@map("statutory_tax_bands")
}

enum StatutoryRateCode {
  SSNIT_EMPLOYEE
  SSNIT_EMPLOYER
}

/// SSNIT contribution rates, applied to basic salary. Same platform-root,
/// effective-dated, no-RLS convention as StatutoryTaxBand. Models the
/// aggregate Tier 1 employee/employer split only — Tier 2 occupational
/// pension trustee routing is a deliberate v1 scope cut (see project
/// memory), left to a future Benefits/Pensions module.
model StatutoryRate {
  id            String            @id @default(uuid())
  countryCode   String            @map("country_code")
  code          StatutoryRateCode
  rate          Decimal
  effectiveFrom DateTime          @map("effective_from")
  effectiveTo   DateTime?         @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@unique([countryCode, code, effectiveFrom])
  @@map("statutory_rates")
}

enum PayRunStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
  CLOSED
  CANCELLED
}

/// One pay cycle for an Organization. Payslips are (re)computed freely while
/// the run is DRAFT/PROCESSING; APPROVED locks the numbers (enforced in
/// PayRunService, not a DB constraint); PAID/CLOSED are terminal
/// record-keeping states.
model PayRun {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  organizationId String       @map("organization_id")
  periodStart    DateTime     @map("period_start")
  periodEnd      DateTime     @map("period_end")
  payDate        DateTime     @map("pay_date")
  status         PayRunStatus @default(DRAFT)
  approvedAt     DateTime?    @map("approved_at")
  approvedBy     String?      @map("approved_by")
  paidAt         DateTime?    @map("paid_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id])
  payslips     Payslip[]

  @@unique([tenantId, organizationId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([organizationId])
  @@map("pay_runs")
}

enum PayslipStatus {
  DRAFT
  APPROVED
  PAID
}

/// One employee's computed pay for a PayRun. baseSalary/currency are copied
/// from Employee at computation time (not re-read live), so an approved
/// payslip's numbers don't silently drift if the employee's compensation
/// changes afterward.
model Payslip {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  payRunId   String        @map("pay_run_id")
  employeeId String        @map("employee_id")
  status     PayslipStatus @default(DRAFT)

  countryCode     String  @map("country_code")
  basicSalary     Decimal @map("basic_salary")
  grossPay        Decimal @map("gross_pay")
  taxableIncome   Decimal @map("taxable_income")
  payeTax         Decimal @map("paye_tax")
  ssnitEmployee   Decimal @map("ssnit_employee")
  ssnitEmployer   Decimal @map("ssnit_employer")
  totalDeductions Decimal @map("total_deductions")
  netPay          Decimal @map("net_pay")
  currency        String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  payRun    PayRun            @relation(fields: [payRunId], references: [id])
  employee  Employee          @relation(fields: [employeeId], references: [id])
  lineItems PayslipLineItem[]

  @@unique([payRunId, employeeId])
  @@index([tenantId])
  @@index([payRunId])
  @@index([employeeId])
  @@map("payslips")
}

enum PayslipLineItemType {
  EARNING
  DEDUCTION
}

/// Ad-hoc earnings/deductions entered per pay run (overtime, allowances,
/// loan repayments, ...). No recurring-allowance catalog in v1 — a
/// deliberate scope cut (see project memory); can be layered on later
/// without changing the payslip shape.
model PayslipLineItem {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  payslipId   String              @map("payslip_id")
  type        PayslipLineItemType
  code        String
  description String?
  amount      Decimal

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  payslip Payslip @relation(fields: [payslipId], references: [id])

  @@index([tenantId])
  @@index([payslipId])
  @@map("payslip_line_items")
}

// ---------------------------------------------------------------------------
// Leave Management (Module 5)
// ---------------------------------------------------------------------------

/// The tenant's own leave-type catalog (e.g. "Annual Leave", "Sick Leave").
/// Unlike Payroll's statutory reference data, this is tenant-owned business
/// policy, not national law applied uniformly, so it's tenantId-scoped and
/// managed by TENANT_ADMIN/HR_MANAGER rather than platform-admin. No
/// statutory-minimum enforcement in v1 (see project memory) — HR is
/// trusted to set defaultEntitlementDays correctly, same as baseSalary.
model LeaveType {
  id                     String  @id @default(uuid())
  tenantId               String  @map("tenant_id")
  name                   String
  code                   String
  isPaid                 Boolean @default(true) @map("is_paid")
  defaultEntitlementDays Decimal @map("default_entitlement_days")
  isActive               Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_types")
}

/// Per-employee, per-leave-type, per-year balance. Annual lump-sum
/// entitlement only in v1 — no monthly accrual engine, no carry-forward
/// rollover job (see project memory for those scope cuts).
model LeaveBalance {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  employeeId   String  @map("employee_id")
  leaveTypeId  String  @map("leave_type_id")
  year         Int
  entitledDays Decimal @map("entitled_days")
  usedDays     Decimal @default(0) @map("used_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@index([employeeId])
  @@map("leave_balances")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Whole-day date ranges only in v1 — no half/partial-day requests, and
/// daysRequested counts weekdays only (no public holiday calendar). See
/// project memory for those scope cuts. Self-service: an EMPLOYEE-role
/// caller may only create/view/cancel their own requests (resolved via
/// Employee.userId, not an arbitrary employeeId) — see project memory,
/// this is the first module where the EMPLOYEE role does anything.
model LeaveRequest {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  employeeId      String             @map("employee_id")
  leaveTypeId     String             @map("leave_type_id")
  startDate       DateTime           @map("start_date")
  endDate         DateTime           @map("end_date")
  daysRequested   Decimal            @map("days_requested")
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  approverUserId  String?            @map("approver_user_id")
  approvedAt      DateTime?          @map("approved_at")
  rejectionReason String?            @map("rejection_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Attendance (Module 6)
// ---------------------------------------------------------------------------

/// One clock-in/clock-out policy per tenant — not per-organization, per-role,
/// or per-employment-type (a deliberate v1 scope cut, see project memory).
/// Tenant-owned business policy, not national law — unlike Payroll's
/// statutory data, no platform-admin governance needed; never hardcoded,
/// same reasoning as LeaveType.defaultEntitlementDays.
model AttendancePolicy {
  id                 String  @id @default(uuid())
  tenantId           String  @unique @map("tenant_id")
  standardDailyHours Decimal @map("standard_daily_hours")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@map("attendance_policies")
}

/// One row per employee per calendar day. No status column — "currently
/// clocked in" is just clockOut IS NULL, not persisted redundant state.
/// hoursWorked/overtimeHours are computed and stored at clock-out time
/// (same denormalization principle as Payslip), so a day's numbers don't
/// drift if the tenant's AttendancePolicy changes afterward. No break/
/// pause tracking in v1 — one clock-in/clock-out pair per day (see
/// project memory).
model AttendanceRecord {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  employeeId    String    @map("employee_id")
  date          DateTime
  clockIn       DateTime? @map("clock_in")
  clockOut      DateTime? @map("clock_out")
  hoursWorked   Decimal?  @map("hours_worked")
  overtimeHours Decimal?  @map("overtime_hours")
  notes         String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([employeeId])
  @@map("attendance_records")
}
