# Copy to .env.production on the server, fill in real values, and never
# commit the filled-in file. Used two ways:
#   1. docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#   2. Sourced by hand (or via `set -a; . ./.env.production; set +a`) when
#      running one-off commands from this checkout against the production
#      database — e.g. `npm run prisma:deploy`, `npm run prisma:seed`.

# The domain you pointed at this server, e.g. app.yourcompany.com
APP_DOMAIN=
# The bare/apex version of the same domain (e.g. yourcompany.com when
# APP_DOMAIN is app.yourcompany.com or www.yourcompany.com) - Caddy
# redirects it to APP_DOMAIN rather than serving the app under two
# different hostnames. Required - Caddy's config fails to parse if this is
# left empty. If you only ever use one hostname with no separate bare
# domain, set it to the same value as APP_DOMAIN.
APEX_DOMAIN=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts TOTP secrets at rest (see libs/iam/domain/src/lib/mfa-secret-crypto.ts).
# The api container refuses to boot without this one. There is no rotation
# story yet — rotating it breaks decryption of every already-enrolled user's
# MFA secret, so treat it as a permanent, one-time value per environment.
MFA_ENCRYPTION_KEY=

# Encrypts EmployeePaymentMethod's bank/mobile-money fields at rest (see
# libs/platform/core/src/lib/crypto/aes-gcm-cipher.ts, PaymentMethodService,
# PayRunService). Use a different value than MFA_ENCRYPTION_KEY - separate
# keys per data domain. The api container refuses to boot without this
# one either. Same no-rotation-story caveat as MFA_ENCRYPTION_KEY.
PAYMENT_METHOD_ENCRYPTION_KEY=

# Paystack secret key - same account, two API surfaces: billing/subscription
# checkout (see libs/billing/feature/src/lib/paystack-client.ts) and payroll
# disbursement via Transfers (see libs/payroll/feature/src/lib/paystack-transfer-client.ts).
# Optional: leave blank to run with placeholders that log instead of
# charging cards or paying employees - the api container boots fine
# without it, only real invoice checkout/webhook verification and real
# payroll payouts need a real value.
PAYSTACK_SECRET_KEY=

# SendGrid — sends real emails for the Notifications module (see
# libs/notifications/feature/src/lib/notification-dispatcher.ts). Both
# optional: leave blank to run with a dispatcher that logs instead of
# sending. SENDGRID_FROM_EMAIL must be a verified sender or on a
# domain-authenticated domain in your SendGrid account.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Bootstrap platform-admin account (see `npm run prisma:seed`) — pick a real
# password here too, then change it after first login.
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=

# Gates /api/docs (Swagger UI + its raw JSON/YAML document) behind HTTP
# Basic Auth in production (see apps/api/src/main.ts). Both optional: leave
# blank and the docs are disabled outright in production rather than left
# unauthenticated — set both to enable them for your own team.
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASSWORD=

# S3-compatible object storage for uploads (organization verification
# documents, the tenant business logo shown to every employee). Locally
# this is MinIO (see docker-compose.yml) — in production it must be a real,
# publicly-reachable provider, since uploads/downloads go straight from the
# browser to this endpoint via a signed URL, never through the API. Any
# S3-compatible provider works, e.g.:
#   - DigitalOcean Spaces (nyc3.digitaloceanspaces.com, region "us-east-1")
#   - Cloudflare R2 (needs STORAGE_FORCE_PATH_STYLE=true)
#   - AWS S3 (STORAGE_FORCE_PATH_STYLE=false, region = your bucket's real region)
# Create one bucket, generate an access key/secret for it, and fill in below.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# Only needed on the host when running Prisma commands directly (not inside
# Docker) — matches the ports docker-compose.prod.yml publishes to 127.0.0.1.
# dotenv does NOT expand variables, so paste the same passwords you used
# above literally in place of <POSTGRES_PASSWORD> / <APP_DB_PASSWORD>.
DATABASE_URL=postgresql://africahr:<POSTGRES_PASSWORD>@localhost:5432/africahr
APP_DATABASE_URL=postgresql://africahr_app:<APP_DB_PASSWORD>@localhost:5432/africahr
