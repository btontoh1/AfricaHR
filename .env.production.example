# Copy to .env.production on the server, fill in real values, and never
# commit the filled-in file. Used two ways:
#   1. docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#   2. Sourced by hand (or via `set -a; . ./.env.production; set +a`) when
#      running one-off commands from this checkout against the production
#      database — e.g. `npm run prisma:deploy`, `npm run prisma:seed`.

# The domain you pointed at this server, e.g. app.yourcompany.com
APP_DOMAIN=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Bootstrap platform-admin account (see `npm run prisma:seed`) — pick a real
# password here too, then change it after first login.
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=

# Only needed on the host when running Prisma commands directly (not inside
# Docker) — matches the ports docker-compose.prod.yml publishes to 127.0.0.1.
# dotenv does NOT expand variables, so paste the same passwords you used
# above literally in place of <POSTGRES_PASSWORD> / <APP_DB_PASSWORD>.
DATABASE_URL=postgresql://africahr:<POSTGRES_PASSWORD>@localhost:5432/africahr
APP_DATABASE_URL=postgresql://africahr_app:<APP_DB_PASSWORD>@localhost:5432/africahr
