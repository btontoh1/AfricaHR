PORT=3000

DATABASE_URL=postgresql://africahr:africahr@localhost:5432/africahr
# Least-privilege runtime role the app actually connects as (see RLS_CONVENTION.md
# and docker/postgres-init/01-create-app-role.sh — password must match APP_DB_PASSWORD).
APP_DATABASE_URL=postgresql://africahr_app:africahr_app@localhost:5432/africahr

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# S3-compatible object storage (MinIO locally — see docker-compose.yml —
# real S3/Spaces/R2 in prod) for verification-document uploads. Values
# below match the minio service's MINIO_ROOT_USER/MINIO_ROOT_PASSWORD.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=africahr-verification-docs
STORAGE_ACCESS_KEY=africahr
STORAGE_SECRET_KEY=africahr-storage-secret
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

LOG_LEVEL=info

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Real email delivery for the EMAIL notification channel. Optional - leave
# both unset to use the LogNotificationDispatcher placeholder (logs instead
# of sending, safe for local/dev). SENDGRID_FROM_EMAIL must be a sender
# verified in your SendGrid account.
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# Required - encrypts TOTP secrets at rest. Generate with: openssl rand -hex 32
# The app fails to boot without this (see MfaService). Rotating this key
# would break decryption of every already-enrolled user's secret - there is
# no rotation story yet, so treat it as a one-time, permanent value per
# environment.
MFA_ENCRYPTION_KEY=

# Required - encrypts EmployeePaymentMethod bank/mobile-money fields at
# rest. Generate with: openssl rand -hex 32 (use a different value than
# MFA_ENCRYPTION_KEY - separate keys per data domain). The app fails to
# boot without this (see PaymentMethodService/PayRunService). Same
# no-rotation-story caveat as MFA_ENCRYPTION_KEY.
PAYMENT_METHOD_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:4200

# Bootstrap platform-admin account (see `npm run prisma:seed`).
SEED_ADMIN_EMAIL=admin@africahr.local
SEED_ADMIN_PASSWORD=
