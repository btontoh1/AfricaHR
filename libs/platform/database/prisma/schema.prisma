// ParotHR — shared-schema, multi-tenant PostgreSQL database.
//
// Tenant isolation convention (see RLS_CONVENTION.md in this directory):
// every tenant-scoped model gets a `tenantId` column, an index on it, and a
// matching Postgres Row-Level Security policy applied via a raw-SQL migration.
// `Tenant` itself is the tenant registry (platform-root) and is exempt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy & Organization (Module 1)
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrganizationVerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum VerificationDocumentType {
  CERTIFICATE_OF_INCORPORATION
  TAX_CLEARANCE_CERTIFICATE
  OTHER
}

/// The SaaS account. Platform-root table — no tenantId, no RLS.
model Tenant {
  id       String       @id @default(uuid())
  name     String
  slug     String       @unique
  status   TenantStatus @default(TRIAL)
  country  String
  currency String
  timezone String

  // Object-storage key for the tenant's uploaded branding logo (shown in the
  // app shell for every employee) - not a URL, since it's served via a
  // short-lived signed view URL minted on read, same pattern as
  // OrganizationVerificationDocument.storageKey.
  logoStorageKey String? @map("logo_storage_key")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  organizations Organization[]
  users         User[]
  subscription  Subscription?
  invoices      Invoice[]

  @@map("tenants")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// One per tenant, per-employee pricing (see project memory: billing v1 is
/// platform-admin-assigned, not tenant self-serve - there's no tenant-side
/// checkout flow). The "amount currently due" isn't stored here - it's
/// computed on read as pricePerEmployee × the tenant's current active
/// employee count (see BillingHeadcountRepository), so it's never stale
/// between invoices.
model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique @map("tenant_id")
  pricePerEmployee     Decimal            @map("price_per_employee")
  currency             String
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  /// Paystack's customer code, minted lazily on the first invoice - not
  /// known until then, since assigning a plan doesn't itself talk to Paystack.
  paystackCustomerCode String?            @map("paystack_customer_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  invoices Invoice[]

  @@map("subscriptions")
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

/// One per billing period. employeeCountAtIssue is a snapshot (the
/// headcount used to compute `amount` at generation time) - deliberately
/// not recomputed later, so a paid invoice's amount stays meaningful even
/// after headcount changes.
model Invoice {
  id                   String        @id @default(uuid())
  tenantId             String        @map("tenant_id")
  subscriptionId       String        @map("subscription_id")
  amount               Decimal
  currency             String
  employeeCountAtIssue Int           @map("employee_count_at_issue")
  status               InvoiceStatus @default(PENDING)
  periodStart          DateTime      @map("period_start")
  periodEnd            DateTime      @map("period_end")
  dueDate              DateTime      @map("due_date")
  paidAt               DateTime?     @map("paid_at")
  /// Paystack transaction reference - the join key the webhook uses to
  /// find this invoice again when payment completes.
  paystackReference    String?       @unique @map("paystack_reference")
  checkoutUrl          String?       @map("checkout_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

/// A legal entity under a tenant (a tenant may own more than one — e.g. a
/// holding company with subsidiaries — so this is tenantId-scoped rather
/// than folded into Tenant as a 1:1).
model Organization {
  id                      String  @id @default(uuid())
  tenantId                String  @map("tenant_id")
  legalName               String  @map("legal_name")
  tradingName             String? @map("trading_name")
  countryCode             String  @map("country_code")
  registrationNumber      String  @map("registration_number")
  taxIdentificationNumber String? @map("tax_identification_number")
  /// Country-specific registration fields that don't warrant a dedicated
  /// column yet (e.g. Ghana SSNIT employer number).
  metadata                Json?

  /// KYB-style review: a PLATFORM_ADMIN verifies the legal-entity fields
  /// above (and any supporting documents) before the org is trusted.
  /// Nothing else in the app currently gates on this status - see the
  /// organization-verification-status domain module for the transition
  /// rules (UNVERIFIED -> PENDING_REVIEW -> VERIFIED/REJECTED).
  verificationStatus OrganizationVerificationStatus @default(UNVERIFIED) @map("verification_status")
  /// Reviewer's reason, set on rejection.
  verificationNote   String?                        @map("verification_note")
  verifiedAt         DateTime?                      @map("verified_at")
  /// Reviewing User's id - bare String like createdBy/updatedBy, no
  /// @relation (same convention as every other audit-trail field here).
  verifiedBy         String?                        @map("verified_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  tenant                Tenant                             @relation(fields: [tenantId], references: [id])
  units                 OrganizationUnit[]
  employees             Employee[]
  payRuns               PayRun[]
  jobRequisitions       JobRequisition[]
  verificationDocuments OrganizationVerificationDocument[]

  @@index([tenantId])
  @@map("organizations")
}

/// Supporting evidence (certificate of incorporation, tax clearance, etc.)
/// uploaded against an Organization's verification review. The file itself
/// lives in object storage (see libs/platform/storage); this row is just
/// the metadata + ownership record - storageKey is never client-supplied,
/// always generated server-side and namespaced per tenant/org.
model OrganizationVerificationDocument {
  id             String                   @id @default(uuid())
  tenantId       String                   @map("tenant_id")
  organizationId String                   @map("organization_id")
  documentType   VerificationDocumentType @map("document_type")
  storageKey     String                   @map("storage_key")
  fileName       String                   @map("file_name")
  contentType    String                   @map("content_type")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId])
  @@index([organizationId])
  @@map("organization_verification_documents")
}

/// Department/branch within an Organization. Self-referencing hierarchy.
model OrganizationUnit {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  organizationId String  @map("organization_id")
  parentId       String? @map("parent_id")
  name           String
  code           String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  organization    Organization       @relation(fields: [organizationId], references: [id])
  parent          OrganizationUnit?  @relation("OrganizationUnitToParent", fields: [parentId], references: [id])
  children        OrganizationUnit[] @relation("OrganizationUnitToParent")
  employees       Employee[]
  jobRequisitions JobRequisition[]

  @@index([tenantId])
  @@index([organizationId])
  @@map("organization_units")
}

// ---------------------------------------------------------------------------
// IAM (Module 2)
// ---------------------------------------------------------------------------

/// Fixed, system-defined roles. Tenants assign users to these; they cannot
/// define their own roles (see project memory for why — a deliberate v1
/// scope cut, not an oversight).
enum SystemRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  HR_MANAGER
  PAYROLL_MANAGER
  EMPLOYEE
}

enum MfaMethod {
  TOTP
  SMS
}

/// tenantId is nullable: null identifies a platform admin, who isn't scoped
/// to any tenant (tenants are ops-provisioned by platform admins, not
/// self-serve). email is globally unique (not per-tenant) so login can
/// resolve a user from email+password alone, without first knowing which
/// tenant to look in.
model User {
  id           String     @id @default(uuid())
  tenantId     String?    @map("tenant_id")
  // Deliberately not @unique here: uniqueness is enforced by a partial
  // index (WHERE deleted_at IS NULL) added via raw SQL migration instead,
  // since Prisma's schema DSL can't express a filtered unique constraint.
  // A plain @unique would let one soft-deleted user permanently block
  // that email from ever being reused - find_user_for_login() already
  // treats deleted_at IS NULL as "the email is free," so the DB
  // constraint needs to agree.
  email        String
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  role         SystemRole
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at")

  /// mfaSecretEncrypted is set as soon as setup() generates a secret (before
  /// the user has proven they scanned it), but mfaEnabled only flips to true
  /// once confirm() verifies a real code from it - see MfaService.
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEncrypted String?   @map("mfa_secret_encrypted")
  mfaEnabledAt       DateTime? @map("mfa_enabled_at")
  /// Which second factor is active once mfaEnabled is true - null while
  /// disabled. Set by MfaService.confirm()/confirmSms(), not user-chosen
  /// after the fact (switching methods means disabling and re-enrolling).
  mfaMethod MfaMethod? @map("mfa_method")

  /// Set (pending, unverified) as soon as setupSms() is called, same
  /// "pending before proof" shape as mfaSecretEncrypted above.
  /// phoneNumberVerifiedAt only gets set once confirmSms() verifies a real
  /// code sent to it - deliberately independent of Employee.phone, which is
  /// unverified HR data, not an authentication credential.
  phoneNumber           String?   @map("phone_number")
  phoneNumberVerifiedAt DateTime? @map("phone_number_verified_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  refreshTokens     RefreshToken[]
  employee          Employee?
  notifications     Notification[]
  mfaBackupCodes    MfaBackupCode[]
  mfaTrustedDevices MfaTrustedDevice[]

  @@index([tenantId])
  @@map("users")
}

/// One-time-use codes issued alongside TOTP enrollment, for account
/// recovery when the authenticator device is lost. tenantId is nullable to
/// mirror User's own nullability (a platform admin's codes have no tenant)
/// - see RLS_CONVENTION.md §4 for the policy variant this needs.
model MfaBackupCode {
  id        String    @id @default(uuid())
  tenantId  String?   @map("tenant_id")
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("mfa_backup_codes")
}

/// Long-lived opaque device-trust token, separate from RefreshToken - lets a
/// user skip the MFA challenge on a specific device for a while without
/// granting any access itself: it only ever changes whether authenticate()
/// issues a challenge, and is never accepted anywhere else. Same
/// nullable-tenant shape as MfaBackupCode - see RLS_CONVENTION.md §4.
model MfaTrustedDevice {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("mfa_trusted_devices")
}

/// Opaque, hashed, stateful — unlike the (stateless, JWT) access token, so
/// logout/revocation is possible. Rotated on every refresh.
model RefreshToken {
  id        String    @id @default(uuid())
  tenantId  String?   @map("tenant_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// Generic audit trail, written via explicit AuditService.record() calls
/// from any module's services — deliberately not automatic/interceptor-based,
/// to keep exactly what gets logged predictable and easy to test.
model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  actorUserId  String?  @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Employee Management (Module 3)
// ---------------------------------------------------------------------------

enum EmploymentStatus {
  PENDING_ONBOARDING
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

/// The employee's HR record. userId is nullable and independent of
/// employmentStatus — HR can onboard someone into the system (or employ
/// someone who never needs portal access) without a User account existing
/// (see project memory for that decision). Compensation here is a current
/// summary only; actual payroll processing (pay runs, tax, payslips) is
/// Module 4's responsibility, which reads this rather than duplicating it.
model Employee {
  id                 String  @id @default(uuid())
  tenantId           String  @map("tenant_id")
  organizationId     String  @map("organization_id")
  organizationUnitId String? @map("organization_unit_id")
  userId             String? @unique @map("user_id")
  managerId          String? @map("manager_id")

  employeeNumber String @map("employee_number")

  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  dateOfBirth   DateTime? @map("date_of_birth")
  gender        String?
  nationality   String?
  phone         String?
  personalEmail String?   @map("personal_email")

  jobTitle         String           @map("job_title")
  employmentType   EmploymentType   @map("employment_type")
  employmentStatus EmploymentStatus @default(PENDING_ONBOARDING) @map("employment_status")
  hireDate         DateTime         @map("hire_date")
  terminationDate  DateTime?        @map("termination_date")

  baseSalary   Decimal? @map("base_salary")
  payFrequency String?  @map("pay_frequency")
  currency     String?

  /// Annual rent paid, used only for Nigeria's Rent Relief Allowance
  /// (Nigeria Tax Act 2025 s.30(2)(a)(vi) - 20% of rent, capped at
  /// NGN 500,000/yr). A dedicated column rather than metadata because it's
  /// a first-class payroll input (updatable, type-safe money), not
  /// auxiliary reference data like a Ghana Card number.
  annualRentPaid Decimal? @map("annual_rent_paid")

  countryCode String @map("country_code")
  /// Country-specific fields without a dedicated column (e.g. Ghana Card
  /// number), same pattern as Organization.metadata.
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  organization       Organization             @relation(fields: [organizationId], references: [id])
  organizationUnit   OrganizationUnit?        @relation(fields: [organizationUnitId], references: [id])
  user               User?                    @relation(fields: [userId], references: [id])
  manager            Employee?                @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports      Employee[]               @relation("EmployeeManager")
  historyEntries     EmploymentHistoryEntry[]
  payslips           Payslip[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  attendanceRecords  AttendanceRecord[]
  benefitEnrollments BenefitEnrollment[]
  performanceGoals   PerformanceGoal[]
  performanceReviews PerformanceReview[]
  hiringRequisitions JobRequisition[]         @relation("JobRequisitionHiringManager")
  hiredApplications  Application[]            @relation("ApplicationHiredEmployee")
  paymentMethod      EmployeePaymentMethod?

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([organizationId])
  @@index([organizationUnitId])
  @@index([managerId])
  @@map("employees")
}

enum PaymentMethodType {
  BANK_ACCOUNT
  MOBILE_MONEY
}

/// How an employee wants to be paid, self-managed by the employee (see
/// MyPaymentMethodController) rather than HR-entered — one active record
/// per employee, upserted in place rather than kept as history. Consumed
/// by PayRunService.markPaid to initiate a real Paystack Transfer payout
/// (bankCode is Paystack's bank/mobile-money-provider code, required to
/// create a transfer recipient — distinct from bankName/
/// mobileMoneyProvider, which are free-text display values only).
/// bankName/bankCode/accountNumber/accountName/mobileMoneyProvider/
/// mobileMoneyNumber are AES-256-GCM encrypted at the service layer
/// before they ever reach this table (see
/// libs/platform/core/src/lib/crypto/aes-gcm-cipher.ts,
/// PaymentMethodService, PayRunService.decryptPaymentMethod) - this
/// column type is still a plain TEXT/String? column since a ciphertext
/// string fits the same shape, no schema change needed beyond that.
model EmployeePaymentMethod {
  id         String            @id @default(uuid())
  tenantId   String            @map("tenant_id")
  employeeId String            @unique @map("employee_id")
  type       PaymentMethodType

  bankName            String? @map("bank_name")
  bankCode            String? @map("bank_code")
  accountNumber       String? @map("account_number")
  accountName         String? @map("account_name")
  mobileMoneyProvider String? @map("mobile_money_provider")
  mobileMoneyNumber   String? @map("mobile_money_number")

  /// Cached Paystack transfer recipient for these exact details - lets
  /// PayRunService reuse it across pay runs instead of calling Paystack's
  /// "Create Transfer Recipient" endpoint on every single disbursement.
  /// Not encrypted (an opaque Paystack-issued identifier, not the
  /// underlying bank/mobile-money details it was derived from) and cleared
  /// back to null on every payment-method edit (see
  /// PaymentMethodRepository.upsert) since a changed bank code/account
  /// number/name invalidates it.
  paystackRecipientCode String? @map("paystack_recipient_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@map("employee_payment_methods")
}

/// Structured, queryable point-in-time history of employment changes (title,
/// department, salary, status) — chosen over relying on AuditLog's generic
/// JSON trail, since "what was X's title on date Y" is a standard HR
/// reporting need AuditLog isn't built to answer well.
model EmploymentHistoryEntry {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  employeeId    String   @map("employee_id")
  /// e.g. "TITLE_CHANGE", "DEPARTMENT_TRANSFER", "STATUS_CHANGE", "SALARY_CHANGE"
  changeType    String   @map("change_type")
  fieldName     String   @map("field_name")
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  effectiveDate DateTime @map("effective_date")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@map("employment_history_entries")
}

// ---------------------------------------------------------------------------
// Payroll Engine (Module 4)
// ---------------------------------------------------------------------------

/// GRA-published monthly PAYE tax bands. Platform-root reference data — no
/// tenantId, no RLS, same exemption as Tenant (see RLS_CONVENTION.md): a
/// tenant does not get to set its own income tax law. Effective-dated so a
/// historical payslip stays reproducible after a rate change. Seeded with
/// placeholder figures that must be confirmed against GRA's current
/// published table before any real payroll run (see seed.ts).
model StatutoryTaxBand {
  id            String    @id @default(uuid())
  countryCode   String    @map("country_code")
  /// Ascending band order within (countryCode, effectiveFrom); band 1 is the
  /// lowest chargeable-income band.
  order         Int
  lowerBound    Decimal   @map("lower_bound")
  /// null = no upper bound (the top band).
  upperBound    Decimal?  @map("upper_bound")
  rate          Decimal
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@index([countryCode, effectiveFrom])
  @@map("statutory_tax_bands")
}

enum StatutoryRateCode {
  SSNIT_EMPLOYEE
  SSNIT_EMPLOYER
  /// Ghana's mandatory Tier 2 occupational pension - employer-only, on top of Tier 1's SSNIT_EMPLOYEE/SSNIT_EMPLOYER above.
  GHANA_TIER2_PENSION_EMPLOYER
  /// Kenya's Social Health Insurance Fund contribution - employee-only, subject to a KES 300 floor enforced in code (see kenya-shif.ts in payroll-domain), not here as data.
  KENYA_SHIF_EMPLOYEE
  /// Kenya's Affordable Housing Levy - employee share.
  KENYA_HOUSING_LEVY_EMPLOYEE
  /// Kenya's Affordable Housing Levy - employer share.
  KENYA_HOUSING_LEVY_EMPLOYER
  /// Nigeria Social Insurance Trust Fund contribution - employer-only, gated in code on the employing organization having 5+ active employees (see payslip-calculator.ts), not here as data.
  NIGERIA_NSITF_EMPLOYER
  /// Nigeria NHIA-mandated health insurance (OPSSHIP) - employee share, gated in code on both the 5+ employee organization threshold and the employee's own basic salary meeting the NGN 30,000 minimum.
  NIGERIA_NHIS_EMPLOYEE
  /// Nigeria NHIA-mandated health insurance (OPSSHIP) - employer share, same gating as NIGERIA_NHIS_EMPLOYEE.
  NIGERIA_NHIS_EMPLOYER
  /// Statutory overtime pay premium multiplier (e.g. 1.5 for time-and-a-half), applied to the employee's implied hourly rate. Country-specific like every other code above, not tenant-configurable - see overtime-pay.ts (payroll-domain).
  OVERTIME_MULTIPLIER
}

/// SSNIT contribution rates, applied to basic salary. Same platform-root,
/// effective-dated, no-RLS convention as StatutoryTaxBand. Models the
/// aggregate Tier 1 employee/employer split only — Tier 2 occupational
/// pension trustee routing is a deliberate v1 scope cut (see project
/// memory), left to a future Benefits/Pensions module.
model StatutoryRate {
  id            String            @id @default(uuid())
  countryCode   String            @map("country_code")
  code          StatutoryRateCode
  rate          Decimal
  effectiveFrom DateTime          @map("effective_from")
  effectiveTo   DateTime?         @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@unique([countryCode, code, effectiveFrom])
  @@map("statutory_rates")
}

enum PayRunStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
  CLOSED
  CANCELLED
}

/// One pay cycle for an Organization. Payslips are (re)computed freely while
/// the run is DRAFT/PROCESSING; APPROVED locks the numbers (enforced in
/// PayRunService, not a DB constraint); PAID/CLOSED are terminal
/// record-keeping states.
model PayRun {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  organizationId String       @map("organization_id")
  periodStart    DateTime     @map("period_start")
  periodEnd      DateTime     @map("period_end")
  payDate        DateTime     @map("pay_date")
  status         PayRunStatus @default(DRAFT)
  approvedAt     DateTime?    @map("approved_at")
  approvedBy     String?      @map("approved_by")
  paidAt         DateTime?    @map("paid_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id])
  payslips     Payslip[]

  @@unique([tenantId, organizationId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([organizationId])
  @@map("pay_runs")
}

enum PayslipStatus {
  DRAFT
  APPROVED
  PAID
}

/// Real-money disbursement state for a payslip's Paystack transfer -
/// separate from PayslipStatus (administrative: has the pay run been
/// marked paid) because the two lifecycles are independent: markPaid()
/// flips every payslip to PAID synchronously, but the actual bank/mobile-
/// money transfer settles asynchronously via webhook, and can fail even
/// after the run is administratively PAID. NOT_INITIATED covers both "no
/// transfer attempted yet" and "employee has no usable payment method."
enum PayslipDisbursementStatus {
  NOT_INITIATED
  PENDING
  SUCCESS
  FAILED
}

/// One employee's computed pay for a PayRun. baseSalary/currency are copied
/// from Employee at computation time (not re-read live), so an approved
/// payslip's numbers don't silently drift if the employee's compensation
/// changes afterward.
model Payslip {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  payRunId   String        @map("pay_run_id")
  employeeId String        @map("employee_id")
  status     PayslipStatus @default(DRAFT)

  countryCode     String  @map("country_code")
  basicSalary     Decimal @map("basic_salary")
  grossPay        Decimal @map("gross_pay")
  taxableIncome   Decimal @map("taxable_income")
  payeTax         Decimal @map("paye_tax")
  ssnitEmployee   Decimal @map("ssnit_employee")
  ssnitEmployer   Decimal @map("ssnit_employer")

  /// Ghana only, else 0 - Tier 2's employer-only contribution. Not part of totalDeductions/netPay, same as ssnitEmployer.
  ghanaTier2PensionEmployer Decimal @default(0) @map("ghana_tier2_pension_employer")
  /// Kenya only, else 0 - reduces taxableIncome and is part of totalDeductions/netPay. See payslip-calculator.ts (payroll-domain).
  kenyaShifEmployee Decimal @default(0) @map("kenya_shif_employee")
  /// Kenya only, else 0 - part of totalDeductions/netPay, but does not reduce taxableIncome (relief repealed December 2024).
  kenyaHousingLevyEmployee Decimal @default(0) @map("kenya_housing_levy_employee")
  /// Kenya only, else 0 - employer-only. Not part of totalDeductions/netPay, same as ssnitEmployer.
  kenyaHousingLevyEmployer Decimal @default(0) @map("kenya_housing_levy_employer")

  /// Nigeria only (and only when the employing organization has 5+ active employees), else 0 - employer-only NSITF contribution. Not part of totalDeductions/netPay, same as ssnitEmployer.
  nigeriaNsitfEmployer Decimal @default(0) @map("nigeria_nsitf_employer")
  /// Nigeria only (org threshold + employee's own basic salary meeting the eligibility floor), else 0 - part of totalDeductions/netPay, but does not reduce taxableIncome (unresolved conflict in secondary sources on tax treatment - defaulted to post-tax, see payslip-calculator.ts).
  nigeriaNhisEmployee Decimal @default(0) @map("nigeria_nhis_employee")
  /// Nigeria only, same gating as nigeriaNhisEmployee, else 0 - employer-only. Not part of totalDeductions/netPay.
  nigeriaNhisEmployer Decimal @default(0) @map("nigeria_nhis_employer")

  /// Sum of every active BenefitEnrollment's employee premium as of the pay date, else 0. Post-tax (does not reduce taxableIncome) and part of totalDeductions/netPay. See payslip-calculator.ts (payroll-domain).
  benefitsEmployeeDeduction Decimal @default(0) @map("benefits_employee_deduction")
  /// Sum of every active BenefitEnrollment's employer premium as of the pay date, else 0 - employer-only. Not part of totalDeductions/netPay, same as ssnitEmployer.
  benefitsEmployerCost Decimal @default(0) @map("benefits_employer_cost")

  /// Value of unpaid-leave days within the pay period at the daily rate, else 0. Informational only - already baked into basicSalary/grossPay above, NOT part of totalDeductions (that would double-count it). See payslip-calculator.ts (payroll-domain).
  unpaidLeaveDeduction Decimal @default(0) @map("unpaid_leave_deduction")

  /// Pay for overtime hours worked within the pay period (attendance records' overtimeHours), at the employee's implied hourly rate times the country's OVERTIME_MULTIPLIER statutory rate, else 0. Already added into grossPay/taxableIncome above - not part of totalDeductions (it's extra pay, not a withholding). See overtime-pay.ts (payroll-domain).
  overtimePay Decimal @default(0) @map("overtime_pay")

  totalDeductions Decimal @map("total_deductions")
  netPay          Decimal @map("net_pay")
  currency        String

  // Paystack Transfers disbursement — set when markPaid() initiates a
  // real payout, updated by the transfer.success/transfer.failed webhook
  // (see PayRunService.markPaid / PayrollTransferWebhookListener).
  // paystackTransferReference is unique so the webhook (which only knows
  // the reference, not the tenant) can find this row via the
  // find_payslip_by_paystack_transfer_reference_across_tenants SECURITY
  // DEFINER function, same shape as invoices.paystack_reference.
  disbursementStatus         PayslipDisbursementStatus @default(NOT_INITIATED) @map("disbursement_status")
  paystackRecipientCode      String?                   @map("paystack_recipient_code")
  paystackTransferReference  String?                   @unique @map("paystack_transfer_reference")
  disbursedAt                DateTime?                 @map("disbursed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  payRun    PayRun            @relation(fields: [payRunId], references: [id])
  employee  Employee          @relation(fields: [employeeId], references: [id])
  lineItems PayslipLineItem[]

  @@unique([payRunId, employeeId])
  @@index([tenantId])
  @@index([payRunId])
  @@index([employeeId])
  @@map("payslips")
}

enum PayslipLineItemType {
  EARNING
  DEDUCTION
}

/// Ad-hoc earnings/deductions entered per pay run (overtime, allowances,
/// loan repayments, ...). No recurring-allowance catalog in v1 — a
/// deliberate scope cut (see project memory); can be layered on later
/// without changing the payslip shape.
model PayslipLineItem {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  payslipId   String              @map("payslip_id")
  type        PayslipLineItemType
  code        String
  description String?
  amount      Decimal

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  payslip Payslip @relation(fields: [payslipId], references: [id])

  @@index([tenantId])
  @@index([payslipId])
  @@map("payslip_line_items")
}

// ---------------------------------------------------------------------------
// Leave Management (Module 5)
// ---------------------------------------------------------------------------

/// The tenant's own leave-type catalog (e.g. "Annual Leave", "Sick Leave").
/// Unlike Payroll's statutory reference data, this is tenant-owned business
/// policy, not national law applied uniformly, so it's tenantId-scoped and
/// managed by TENANT_ADMIN/HR_MANAGER rather than platform-admin. No
/// statutory-minimum enforcement in v1 (see project memory) — HR is
/// trusted to set defaultEntitlementDays correctly, same as baseSalary.
model LeaveType {
  id                     String  @id @default(uuid())
  tenantId               String  @map("tenant_id")
  name                   String
  code                   String
  isPaid                 Boolean @default(true) @map("is_paid")
  defaultEntitlementDays Decimal @map("default_entitlement_days")
  isActive               Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_types")
}

/// Per-employee, per-leave-type, per-year balance. Annual lump-sum
/// entitlement only in v1 — no monthly accrual engine, no carry-forward
/// rollover job (see project memory for those scope cuts).
model LeaveBalance {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  employeeId   String  @map("employee_id")
  leaveTypeId  String  @map("leave_type_id")
  year         Int
  entitledDays Decimal @map("entitled_days")
  usedDays     Decimal @default(0) @map("used_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@index([employeeId])
  @@map("leave_balances")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Whole-day date ranges only in v1 — no half/partial-day requests, and
/// daysRequested counts weekdays only (no public holiday calendar). See
/// project memory for those scope cuts. Self-service: an EMPLOYEE-role
/// caller may only create/view/cancel their own requests (resolved via
/// Employee.userId, not an arbitrary employeeId) — see project memory,
/// this is the first module where the EMPLOYEE role does anything.
model LeaveRequest {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  employeeId      String             @map("employee_id")
  leaveTypeId     String             @map("leave_type_id")
  startDate       DateTime           @map("start_date")
  endDate         DateTime           @map("end_date")
  daysRequested   Decimal            @map("days_requested")
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  approverUserId  String?            @map("approver_user_id")
  approvedAt      DateTime?          @map("approved_at")
  rejectionReason String?            @map("rejection_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Attendance (Module 6)
// ---------------------------------------------------------------------------

/// One clock-in/clock-out policy per tenant — not per-organization, per-role,
/// or per-employment-type (a deliberate v1 scope cut, see project memory).
/// Tenant-owned business policy, not national law — unlike Payroll's
/// statutory data, no platform-admin governance needed; never hardcoded,
/// same reasoning as LeaveType.defaultEntitlementDays.
model AttendancePolicy {
  id                 String  @id @default(uuid())
  tenantId           String  @unique @map("tenant_id")
  standardDailyHours Decimal @map("standard_daily_hours")

  /// Optional single work-site geofence: when all three are set, clock-in/
  /// out events are checked against this center point + radius. Absent by
  /// default — geofencing is opt-in per tenant. Deliberately flag-only, not
  /// enforced (see AttendanceRecord fields below) — device GPS commonly
  /// drifts 20-50m+ indoors/urban, so hard-blocking on it would just
  /// generate false-positive support tickets instead of catching anything.
  geofenceLatitude     Decimal? @map("geofence_latitude")
  geofenceLongitude    Decimal? @map("geofence_longitude")
  geofenceRadiusMeters Int?     @map("geofence_radius_meters")
  /// Human-readable label for the geofence (e.g. "East Legon Office"), shown
  /// on the attendance dashboard next to flagged/unflagged punches. Purely
  /// cosmetic — never used in the haversine distance check itself — so it's
  /// independent of the three fields above rather than part of their
  /// all-or-nothing validation (see AttendancePolicyService.upsert).
  geofenceLocationName String? @map("geofence_location_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@map("attendance_policies")
}

/// One row per employee per calendar day. No status column — "currently
/// clocked in" is just clockOut IS NULL, not persisted redundant state.
/// hoursWorked/overtimeHours are computed and stored at clock-out time
/// (same denormalization principle as Payslip), so a day's numbers don't
/// drift if the tenant's AttendancePolicy changes afterward. No break/
/// pause tracking in v1 — one clock-in/clock-out pair per day (see
/// project memory).
model AttendanceRecord {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  employeeId    String    @map("employee_id")
  date          DateTime
  clockIn       DateTime? @map("clock_in")
  clockOut      DateTime? @map("clock_out")
  hoursWorked   Decimal?  @map("hours_worked")
  overtimeHours Decimal?  @map("overtime_hours")
  notes         String?

  /// Device-reported GPS position captured at the moment of the punch, plus
  /// the resulting check against the tenant's AttendancePolicy geofence (if
  /// one is configured). Both null when the browser didn't provide a
  /// location (permission denied, no GPS) — clocking in/out is never
  /// blocked on this. *OutsideGeofence is further null (distinct from
  /// false) when a location was captured but the tenant has no geofence
  /// configured to judge it against - see AttendanceRecordService.
  clockInLatitude        Decimal? @map("clock_in_latitude")
  clockInLongitude       Decimal? @map("clock_in_longitude")
  clockInDistanceMeters  Int?     @map("clock_in_distance_meters")
  clockInOutsideGeofence Boolean? @map("clock_in_outside_geofence")

  clockOutLatitude        Decimal? @map("clock_out_latitude")
  clockOutLongitude       Decimal? @map("clock_out_longitude")
  clockOutDistanceMeters  Int?     @map("clock_out_distance_meters")
  clockOutOutsideGeofence Boolean? @map("clock_out_outside_geofence")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  // Not unique: an employee can clock in/out multiple times in the same
  // calendar day (e.g. a lunch-break split shift) - each cycle is its own row.
  @@index([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([employeeId])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Benefits (Module 7)
// ---------------------------------------------------------------------------

enum BenefitContributionType {
  PERCENTAGE
  FIXED
}

/// The tenant's own benefit-plan catalog (e.g. "Private Health Insurance",
/// "Group Life"). Tenant-owned business policy, not national law — same
/// governance model as LeaveType (TENANT_ADMIN/HR_MANAGER managed, not
/// platform-admin). employeeContribution/employerContribution are
/// interpreted as a fraction of base salary (PERCENTAGE) or a flat monthly
/// amount (FIXED) depending on contributionType — same employee/employer
/// split shape as Payroll's SSNIT rates.
model BenefitPlan {
  id                   String                  @id @default(uuid())
  tenantId             String                  @map("tenant_id")
  name                 String
  code                 String
  description          String?
  contributionType     BenefitContributionType @map("contribution_type")
  employeeContribution Decimal                 @map("employee_contribution")
  employerContribution Decimal                 @map("employer_contribution")
  isActive             Boolean                 @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  enrollments BenefitEnrollment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("benefit_plans")
}

enum BenefitEnrollmentStatus {
  ACTIVE
  CANCELLED
}

/// Links an Employee to a BenefitPlan. No denormalized contribution amount
/// here — unlike Payslip/AttendanceRecord, an enrollment has no single
/// point-in-time event to snapshot at; the current contribution is always
/// computed live from the employee's current baseSalary and the plan's
/// current rates (see project memory). "One active enrollment per employee
/// per plan" is enforced at the service layer only, not a DB constraint —
/// same accepted v1 gap as Employee's employee-number generation.
model BenefitEnrollment {
  id            String                  @id @default(uuid())
  tenantId      String                  @map("tenant_id")
  employeeId    String                  @map("employee_id")
  benefitPlanId String                  @map("benefit_plan_id")
  status        BenefitEnrollmentStatus @default(ACTIVE)
  effectiveDate DateTime                @map("effective_date")
  endDate       DateTime?               @map("end_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  employee    Employee    @relation(fields: [employeeId], references: [id])
  benefitPlan BenefitPlan @relation(fields: [benefitPlanId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([benefitPlanId])
  @@map("benefit_enrollments")
}

// ---------------------------------------------------------------------------
// Performance (Module 8)
// ---------------------------------------------------------------------------

enum PerformanceGoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// An employee's own ongoing goal tracking. Standalone — not tied to a
/// PerformanceReviewCycle in v1 (a deliberate scope cut, see project
/// memory); goals and reviews aren't hard-linked.
model PerformanceGoal {
  id              String                @id @default(uuid())
  tenantId        String                @map("tenant_id")
  employeeId      String                @map("employee_id")
  title           String
  description     String?
  targetDate      DateTime?             @map("target_date")
  status          PerformanceGoalStatus @default(NOT_STARTED)
  progressPercent Int                   @default(0) @map("progress_percent")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@map("performance_goals")
}

enum PerformanceReviewCycleStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

/// The tenant's own review-period catalog (e.g. "Q1 2026 Review").
/// Tenant-owned business policy, TENANT_ADMIN/HR_MANAGER managed — same
/// governance model as LeaveType.
model PerformanceReviewCycle {
  id        String                       @id @default(uuid())
  tenantId  String                       @map("tenant_id")
  name      String
  startDate DateTime                     @map("start_date")
  endDate   DateTime                     @map("end_date")
  status    PerformanceReviewCycleStatus @default(UPCOMING)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  reviews PerformanceReview[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("performance_review_cycles")
}

enum PerformanceReviewStatus {
  DRAFT
  SELF_SUBMITTED
  COMPLETED
  CANCELLED
}

/// One per employee per cycle, created on-demand (not bulk-generated when
/// a cycle opens — a deliberate scope cut, see project memory). Three-tier
/// authorization: self (submit self-assessment), the employee's direct
/// manager via Employee.managerId (submit manager assessment), and
/// PERFORMANCE_MANAGE/READ (HR, view/override any review) — the first
/// module to use the manager relationship for authorization, not just a
/// role permission (see project memory).
model PerformanceReview {
  id         String                  @id @default(uuid())
  tenantId   String                  @map("tenant_id")
  employeeId String                  @map("employee_id")
  cycleId    String                  @map("cycle_id")
  status     PerformanceReviewStatus @default(DRAFT)

  selfRating      Int?      @map("self_rating")
  selfComments    String?   @map("self_comments")
  selfSubmittedAt DateTime? @map("self_submitted_at")

  managerRating     Int?      @map("manager_rating")
  managerComments   String?   @map("manager_comments")
  managerUserId     String?   @map("manager_user_id")
  managerReviewedAt DateTime? @map("manager_reviewed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  employee Employee               @relation(fields: [employeeId], references: [id])
  cycle    PerformanceReviewCycle @relation(fields: [cycleId], references: [id])

  @@unique([tenantId, employeeId, cycleId])
  @@index([tenantId])
  @@index([employeeId])
  @@index([cycleId])
  @@map("performance_reviews")
}

// ---------------------------------------------------------------------------
// Recruitment (Module 9)
// ---------------------------------------------------------------------------

enum JobRequisitionStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

/// A request to hire for a role. hiringManagerId is optional (a requisition
/// can exist before a hiring manager is assigned) and is what makes the
/// hiring-manager authorization tier possible — the second application of
/// the manager-authorization pattern introduced in Module 8 (see project
/// memory), this time on JobRequisition rather than Employee.managerId.
model JobRequisition {
  id                 String               @id @default(uuid())
  tenantId           String               @map("tenant_id")
  organizationId     String               @map("organization_id")
  organizationUnitId String?              @map("organization_unit_id")
  hiringManagerId    String?              @map("hiring_manager_id")
  title              String
  description        String?
  employmentType     EmploymentType       @map("employment_type")
  openings           Int                  @default(1)
  status             JobRequisitionStatus @default(DRAFT)
  targetHireDate     DateTime?            @map("target_hire_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  hiringManager    Employee?         @relation("JobRequisitionHiringManager", fields: [hiringManagerId], references: [id])
  applications     Application[]

  @@index([tenantId])
  @@index([organizationId])
  @@index([hiringManagerId])
  @@map("job_requisitions")
}

/// A person applying — standalone, tenant-scoped; not tied to a single
/// requisition (can apply to several via separate Application rows).
model Candidate {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  email     String
  phone     String?
  source    String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  applications Application[]

  @@index([tenantId])
  @@map("candidates")
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

/// Links a Candidate to a JobRequisition and tracks the pipeline. Offer
/// details are folded in directly rather than a separate Offer model — one
/// offer per application is the norm (see project memory). No automatic
/// Employee creation when an offer is accepted — HR creates the Employee
/// via the existing Module 3 flow and can optionally set hiredEmployeeId
/// afterward for traceability (see project memory: modules stay decoupled,
/// wired later, same pattern as Leave/Attendance/Benefits <-> Payroll).
model Application {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  candidateId     String           @map("candidate_id")
  requisitionId   String           @map("requisition_id")
  stage           ApplicationStage @default(APPLIED)
  appliedAt       DateTime         @default(now()) @map("applied_at")
  notes           String?
  rejectionReason String?          @map("rejection_reason")

  offeredSalary    Decimal?  @map("offered_salary")
  offeredStartDate DateTime? @map("offered_start_date")
  offerSentAt      DateTime? @map("offer_sent_at")
  offerRespondedAt DateTime? @map("offer_responded_at")
  offerAccepted    Boolean?  @map("offer_accepted")

  hiredEmployeeId String? @map("hired_employee_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  candidate     Candidate      @relation(fields: [candidateId], references: [id])
  requisition   JobRequisition @relation(fields: [requisitionId], references: [id])
  hiredEmployee Employee?      @relation("ApplicationHiredEmployee", fields: [hiredEmployeeId], references: [id])

  @@unique([tenantId, candidateId, requisitionId])
  @@index([tenantId])
  @@index([candidateId])
  @@index([requisitionId])
  @@index([hiredEmployeeId])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// Notifications (Module 11)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Tenant-owned reusable message content ({{variable}} placeholders in
/// subject/body), same governance pattern as LeaveType/BenefitPlan/
/// PerformanceReviewCycle — TENANT_ADMIN/HR_MANAGER manage it directly, no
/// platform-admin governance. Notification does not reference this by id
/// once sent (see Notification's own doc comment), so editing or deleting a
/// template never rewrites history.
model NotificationTemplate {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  code            String
  name            String
  channel         NotificationChannel
  subjectTemplate String              @map("subject_template")
  bodyTemplate    String              @map("body_template")
  isActive        Boolean             @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("notification_templates")
}

/// A notification sent to a User, not an Employee — a notification is
/// inherently a portal-identity concern, so self-service resolves the
/// recipient directly from the JWT's userId with no Employee lookup, unlike
/// every self-service module since Leave (Module 5). subject/body are the
/// rendered text at send time, not a live reference to the template that
/// produced them — same denormalization principle as Payslip/
/// AttendanceRecord, so a later template edit never rewrites history.
/// IN_APP delivery is the row itself (status SENT the moment it's created);
/// EMAIL goes through a NotificationDispatcher and can end up FAILED.
/// No automatic cross-module triggers in v1 (see project memory) — every
/// row here was created by an explicit send() call, HR-initiated or
/// system-initiated, never an implicit side effect of another module's
/// business event.
model Notification {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  userId        String              @map("user_id")
  channel       NotificationChannel
  subject       String
  body          String
  status        NotificationStatus  @default(PENDING)
  isRead        Boolean             @default(false) @map("is_read")
  readAt        DateTime?           @map("read_at")
  sentAt        DateTime?           @map("sent_at")
  failureReason String?             @map("failure_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}
